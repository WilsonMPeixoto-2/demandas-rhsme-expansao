{
  "name": "demandas-rhsme",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "bootstrap:supabase": "node --env-file=.env.bootstrap scripts/bootstrap-supabase.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "migration:prepare": "node scripts/migration/prepare-legacy-csv.mjs",
    "migration:dry-run": "node scripts/migration/dry-run-import.mjs",
    "check": "npm audit --audit-level=high && npm audit signatures && npm run lint && npm run test:coverage && npm run build && npm run check:bundle && npm run check:public-bundle",
    "check:full": "npm run check && npm run test:e2e",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:public-bundle": "node scripts/check-public-bundle.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@hookform/resolvers": "5.4.0",
    "@radix-ui/react-alert-dialog": "1.1.20",
    "@radix-ui/react-dialog": "1.1.20",
    "@radix-ui/react-dropdown-menu": "2.1.21",
    "@supabase/supabase-js": "2.110.8",
    "@tanstack/react-table": "8.21.3",
    "exceljs": "4.4.0",
    "motion": "12.42.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.82.0",
    "react-router-dom": "7.18.1",
    "sonner": "2.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "csv-parse": "7.0.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "jszip": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
