{
  "name": "demandas-rhsme",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "bootstrap:supabase": "node --env-file=.env.bootstrap scripts/bootstrap-supabase.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "migration:prepare": "node scripts/migration/prepare-legacy-csv.mjs",
    "migration:dry-run": "node scripts/migration/dry-run-import.mjs",
    "check:docs": "node --test scripts/docs/check-current-plan-references.test.mjs && node scripts/docs/check-current-plan-references.mjs",
    "check": "npm audit --audit-level=high && npm audit signatures && npm run test:dependency-compat && npm run check:docs && npm run lint && npm run test:coverage && npm run build && npm run check:bundle && npm run check:public-bundle",
    "check:full": "npm run check && npm run test:e2e",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:public-bundle": "node scripts/check-public-bundle.mjs",
    "test:dependency-compat": "node --test scripts/brace-expansion-compat.node.mjs",
    "analyze:unused": "knip --no-progress --reporter compact --no-exit-code"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@hookform/resolvers": "5.7.1",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@supabase/supabase-js": "2.112.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "exceljs": "4.4.0",
    "motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "react-router": "8.3.0",
    "sonner": "2.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "csv-parse": "7.0.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "jszip": "3.10.1",
    "knip": "6.32.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
